# Copy to .env and fill in. Railway/Render set these as service variables.
DATABASE_URL="postgresql://user:password@host:5432/packmate"

# Signs access tokens. Generate with: openssl rand -base64 48
# Rotating this invalidates every access token immediately (refresh tokens
# survive, because they are random strings checked against the database).
ACCESS_TOKEN_SECRET=""

PORT=8080

# Optional, for Google sign-in. Comma-separated: the OAuth client IDs your
# apps use, which are the only audiences an ID token may claim.
GOOGLE_CLIENT_IDS=""

# Optional, for Apple sign-in. Your iOS bundle id.
APPLE_BUNDLE_IDS="com.vinayrv.packmate"

# Email delivery. Required: sign-up sends a verification code, and a server
# that cannot send them will refuse to start rather than swallow them.
# Get a key at resend.com, then verify a sending domain.
RESEND_API_KEY=""
MAIL_FROM="Packmate <hello@yourdomain.com>"
